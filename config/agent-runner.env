APP_NAME=agent-runner
SERVER_PORT=8001
AGENT_RUNNER_DEBUG=false
NACOS_ENABLED=true
OPEN_BROWSER_ON_STARTUP=true
CONVERSATION_RPC_URL=tri://127.0.0.1:20880
DEFAULT_AGENT_ID=1

LITE_LLM_BASE_URL=http://localhost:4000
LITE_LLM_API_KEY=sk-agent-breaker-local
LITE_LLM_REQUEST_TIMEOUT_SECONDS=120
LITE_LLM_CONNECT_TIMEOUT_SECONDS=3
LITE_LLM_MAX_RETRIES=0

AGENT_CONFIG_CENTER_URL=http://localhost:8081
CONVERSATION_SERVICE_URL=http://localhost:8082
USER_PROFILER_URL=http://localhost:8083
KNOWLEDGE_SERVICE_URL=http://localhost:8084
LOCAL_AGENT_CONFIG_ENABLED=true
LOCAL_AGENT_CONFIG_PATH=./config/agents.json
AGENT_CONFIG_CACHE_ENABLED=false
MCP_POOL_MAX_CONNECTIONS_PER_SERVER=4
MCP_POOL_IDLE_TIMEOUT_SECONDS=300
MCP_POOL_BORROW_TIMEOUT_SECONDS=10

MAX_CONTEXT_TOKENS=128000
MAX_OUTPUT_TOKENS=4096
OTEL_ENABLED=true
OTEL_SERVICE_NAME=agent-runner
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_CAPTURE_CONTENT=true
OTEL_CONTENT_MAX_CHARS=16384
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
