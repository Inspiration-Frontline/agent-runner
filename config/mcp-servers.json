{
  "mcpServers": {
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "display_name": "DeepWiki"
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp",
      "display_name": "Microsoft Learn"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "display_name": "Context7",
      "headers": {
        "Authorization": "Bearer ${secret:CONTEXT7_API_KEY}"
      }
    },
    "tavily": {
      "url": "https://mcp.tavily.com/mcp/",
      "display_name": "Tavily",
      "headers": {
        "Authorization": "Bearer ${secret:TAVILY_API_KEY}"
      }
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "display_name": "Exa",
      "headers": {
        "x-api-key": "${secret:EXA_API_KEY}"
      }
    },
    "openai-docs": {
      "url": "https://developers.openai.com/mcp",
      "display_name": "OpenAI Developer Docs"
    },
    "mcp-test-fixture": {
      "url": "http://127.0.0.1:8765/mcp",
      "display_name": "Local MCP Test Fixture",
      "schema_cache_ttl_seconds": 60
    },
    "mcp-test-fixture-short-timeout": {
      "url": "http://127.0.0.1:8765/mcp",
      "display_name": "Local MCP Timeout Test Fixture",
      "request_timeout_seconds": 1,
      "schema_cache_ttl_seconds": 60
    },
    "mcp-test-fixture-auth": {
      "url": "http://127.0.0.1:8766/mcp",
      "display_name": "Authenticated Local MCP Test Fixture",
      "headers": {
        "Authorization": "${secret:MCP_TEST_AUTHORIZATION}"
      },
      "schema_cache_ttl_seconds": 60
    }
  }
}
